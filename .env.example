# Configure privately in .env.local and the frontend hosting environment.
NENE_BACKEND_URL=https://your-backend.example
NENE_API_TOKEN=replace-privately
SENTRY_DSN=replace-with-project-dsn
NEXT_PUBLIC_SENTRY_DSN=replace-with-project-dsn
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Only NEXT_PUBLIC_SENTRY_DSN is included in the browser; it is a public ingest address.
# Never prefix backend credentials or Sentry API auth tokens with NEXT_PUBLIC_.
